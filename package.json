{
  "name": "soundfart",
  "productName": "SoundFart",
  "version": "1.5.0",
  "description": "SoundFart - soundboard pour Discord",
  "author": "Benoit Prudent",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node --test test/"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "compression": "store",
    "appId": "fr.soundfart.app",
    "productName": "SoundFart",
    "files": [
      "main.js",
      "main/**/*",
      "preload.js",
      "AudioEndpoint.cs",
      "AudioTap.cs",
      "lib/**/*",
      "assets/**/*",
      "src/**/*",
      "THIRD-PARTY-NOTICES"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "SoundFart.exe"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
