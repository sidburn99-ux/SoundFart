{
  "name": "soundfart",
  "productName": "SoundFart",
  "version": "1.4.0",
  "description": "SoundFart - soundboard pour Discord",
  "author": "Benoit Prudent",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "fr.soundfart.app",
    "productName": "SoundFart",
    "files": ["main.js", "preload.js", "AudioEndpoint.cs", "AudioTap.cs", "vendor/**/*", "assets/**/*", "src/**/*"],
    "win": {
      "target": ["portable", "nsis"],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "SoundFart.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "SoundFart-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    }
  }
}
