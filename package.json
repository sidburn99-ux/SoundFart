{
  "name": "soundfart",
  "productName": "SoundFart",
  "version": "1.3.0",
  "description": "SoundFart - soundboard pour Discord",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "fr.soundfart.app",
    "productName": "SoundFart",
    "files": ["main.js", "preload.js", "AudioEndpoint.cs", "AudioTap.cs", "vendor/**/*", "assets/**/*", "src/**/*", "index.html", "style.css", "app.js"],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "SoundFart.exe"
    }
  }
}
